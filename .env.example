# Runtime
NODE_ENV=development
API_PORT=4000
WEB_PORT=8080

# PostgreSQL
POSTGRES_DB=myvapp
POSTGRES_USER=myvapp_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Docker Compose uses the postgres service hostname below.
# For local non-Docker development, replace `postgres` with `localhost`.
DATABASE_URL=postgresql://myvapp_user:change_me@postgres:5432/myvapp?schema=public

# Platform authentication
# This secret signs platform and election access tokens.
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# Application URLs
CLIENT_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
VITE_API_URL=http://localhost:4000/api/v1

# Seed data
# These accounts exist for local development and seeded demo flows.
SEED_ADMIN_EMAIL=admin@myvapp.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_MANAGER_EMAIL=manager@myvapp.local
SEED_MANAGER_PASSWORD=ChangeMe123!
SEED_VOTER_EMAIL=voter1@myvapp.local
SEED_VOTER_PASSWORD=ChangeMe123!
SEED_ORGANIZATION_NAME=MyVapp Demo Council

# Product direction note
# MyVapp is built around election-scoped voter access.
# Voters participate through approved election voter rolls and one-time invite links.
# Public self-registration is not the primary voter access model.
#
# Future environment variables will be added for:
# - election invite delivery
# - voter CSV import processing
# - election-scoped session policy
# - audit and export workflows
