generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  ELECTION_MANAGER
  VOTER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VOTER
}

enum ElectionStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  ARCHIVED
}

enum ElectionEligibilityStatus {
  PENDING
  INVITED
  CLAIMED
  VOTED
  REVOKED
  EXPIRED
}

enum ImportSourceFormat {
  CSV
  XLSX
}

model User {
  id                           String                        @id @default(cuid())
  email                        String                        @unique
  passwordHash                 String
  firstName                    String
  lastName                     String
  role                         UserRole                      @default(VOTER)
  status                       UserStatus                    @default(ACTIVE)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  memberships                  OrganizationMember[]
  ballots                      Ballot[]
  auditLogs                    AuditLog[]
  uploadedEligibilityImportJobs ElectionEligibilityImportJob[] @relation("EligibilityImportUploader")
  claimedElectionEligibilities ElectionEligibility[]         @relation("ClaimedElectionEligibility")
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String?
  themePreset String               @default("myvapp-default")
  themeOverrides Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  elections   Election[]
  members     OrganizationMember[]
  auditLogs   AuditLog[]
}

model OrganizationMember {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(VOTER)
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Election {
  id                String                        @id @default(cuid())
  organizationId    String
  title             String
  slug              String
  publicSlug        String?                       @unique
  description       String?
  status            ElectionStatus                @default(DRAFT)
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  organization      Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offices           Office[]
  ballots           Ballot[]
  eligibilityImports ElectionEligibilityImportJob[]
  eligibilities     ElectionEligibility[]

  @@unique([organizationId, slug])
}

model ElectionEligibilityImportJob {
  id               String             @id @default(cuid())
  electionId        String
  uploadedByUserId String
  filename         String
  sourceFormat     ImportSourceFormat
  summary          Json?
  committedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  election         Election           @relation(fields: [electionId], references: [id], onDelete: Cascade)
  uploadedBy       User               @relation("EligibilityImportUploader", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  eligibilities    ElectionEligibility[]

  @@index([electionId, createdAt(sort: Desc)])
}

model ElectionEligibility {
  id              String                    @id @default(cuid())
  electionId       String
  importJobId      String?
  memberUniqueId  String
  fullName        String
  age             Int
  email           String
  status          ElectionEligibilityStatus @default(PENDING)
  claimedByUserId String?
  claimedAt       DateTime?
  votedAt         DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  election        Election                  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  importJob       ElectionEligibilityImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  claimedBy       User?                     @relation("ClaimedElectionEligibility", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  invites         ElectionInvite[]

  @@unique([electionId, memberUniqueId])
  @@unique([electionId, email])
  @@index([electionId, status])
}

model ElectionInvite {
  id            String              @id @default(cuid())
  eligibilityId String
  tokenHash     String              @unique
  expiresAt     DateTime
  sentAt        DateTime?
  usedAt        DateTime?
  revokedAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  eligibility   ElectionEligibility @relation(fields: [eligibilityId], references: [id], onDelete: Cascade)

  @@index([eligibilityId, createdAt(sort: Desc)])
}

model Office {
  id          String      @id @default(cuid())
  electionId  String
  title       String
  description String?
  seats       Int         @default(1)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  election    Election    @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidates  Candidate[]
  votes       Vote[]
}

model Candidate {
  id          String    @id @default(cuid())
  officeId    String
  displayName String
  bio         String?
  manifesto   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  office      Office    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  votes       Vote[]
}

model Ballot {
  id         String    @id @default(cuid())
  electionId String
  voterId    String
  submittedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  election   Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  voter      User      @relation(fields: [voterId], references: [id], onDelete: Cascade)
  votes      Vote[]

  @@unique([electionId, voterId])
}

model Vote {
  id          String    @id @default(cuid())
  ballotId    String
  officeId    String
  candidateId String
  createdAt   DateTime  @default(now())
  ballot      Ballot    @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  office      Office    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([ballotId, officeId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String
  action         String
  targetType     String
  targetId       String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  actor          User         @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
}
